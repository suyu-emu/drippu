{
  "policy_version": "suyu-package-policy-1",
  "description": "Package-policy validation rules shared by the exporter (src/common/package_policy.cpp) and release tooling (tools/package_policy/scan_release.py). These are project distribution controls: they decide what the project ships and what the exporter copies. They are not license terms, they do not verify ownership, and passing them is not a legal clearance.",
  "notes": [
    "Names are compared case-insensitively after trailing dots and spaces are removed, because Windows ignores both.",
    "Content signatures are checked in addition to names; a renamed file is still caught when its contents match.",
    "tests/package_policy/test_policy_sync.py fails when the C++ tables and this file disagree."
  ],
  "key_file_name_patterns": [
    "^(prod|title|console|dev)\\.keys(_autogenerated)?([._-].*)?$",
    "^(prod|title|console|dev)[._-]?keys(\\.(txt|ini|bak|old|dat))?$",
    "^.*\\.keys$",
    "^keys\\.(txt|ini|dat)$",
    "^(fuses?|tsec(_keys?)?|secure_boot|sbk)\\.(bin|txt|keys)$"
  ],
  "firmware_nand_name_patterns": [
    "^boot[01](\\.bin)?$",
    "^rawnand(\\.bin)?(\\.\\d+)?$",
    "^prodinfo(f)?(\\.bin)?$",
    "^(safe|system|user)\\.bin$",
    "^bcpkg2-[1-4]-.*$",
    "^package[12](\\.bin)?$",
    "^(firmware|nand)[._-].*\\.(zip|7z|rar|tar)$"
  ],
  "firmware_nand_path_patterns": [
    "(^|/)system/contents/registered(/|$)",
    "(^|/)nand/system(/|$)",
    "(^|/)system/save/80000000000000(43|e1|e2|51|52|53)(/|$)"
  ],
  "game_container_extensions": [".nsp", ".xci", ".nsz", ".xcz", ".nca", ".ncz", ".nro", ".nso", ".nax0"],
  "game_export_marker_names": [
    "readme_native_export.txt",
    "game_source.txt",
    "aot_manifest.json",
    "export-package.json",
    ".suyu-export-package.json",
    "recomp_registration.c",
    "recomp_modules.cmake",
    "romfs.bin",
    "control.nca",
    "main.npdm",
    "recomp_gaps.json",
    "suyu-install.txt"
  ],
  "user_data_path_patterns": [
    "(^|/)nand/user/save(/|$)",
    "(^|/)user/save(/|$)",
    "(^|/)cache/shader(/|$)",
    "(^|/)(qt-config|sdl2-config)\\.ini$",
    "(^|/)config/custom/[0-9a-f]{16}\\.ini$",
    "(^|/)profiles\\.dat$",
    "(^|/)(crash_dumps|dump|log)/",
    "\\.dmp$"
  ],
  "content_signatures": [
    {"name": "Nintendo PFS0 container (NSP)", "offset": 0, "hex": "50465330"},
    {"name": "Nintendo HFS0 partition", "offset": 0, "hex": "48465330"},
    {"name": "Nintendo XCI header", "offset": 256, "hex": "48454144"},
    {"name": "Nintendo NSO executable", "offset": 0, "hex": "4e534f30"},
    {"name": "Nintendo NRO executable", "offset": 16, "hex": "4e524f30"},
    {"name": "Nintendo NPDM metadata", "offset": 0, "hex": "4d455441"},
    {"name": "Nintendo NAX0 archive", "offset": 32, "hex": "4e415830"},
    {"name": "Compressed NCZ section table", "offset": 16384, "hex": "4e435a534543544e"}
  ],
  "key_text_patterns": [
    "(?im)^\\s*(master_key|master_kek|keyblob|keyblob_key|keyblob_mac_key|encrypted_keyblob|titlekek|package1_key|package2_key|key_area_key_(application|ocean|system))_[0-9a-f]{2}\\s*=\\s*[0-9a-f]{32,}",
    "(?im)^\\s*(header_key|header_kek|sd_seed|tsec_key|secure_boot_key|eticket_rsa_kek|eticket_rsa_keypair|eticket_extended_kek|sd_card_kek_source|aes_kek_generation_source|aes_key_generation_source|bis_key_0[0-3])\\s*=\\s*[0-9a-f]{32,}",
    "(?im)^\\s*[0-9a-f]{32}\\s*=\\s*[0-9a-f]{32}\\s*$"
  ],
  "key_text_scan_limit_bytes": 65536,
  "release_layouts": {
    "windows": [
      "suyu\\.exe", "suyu-cmd\\.exe", "[^/]+\\.dll", "LICENSE\\.txt",
      "export-build-kit/.+",
      "(plugins|platforms|styles|imageformats|iconengines|tls|generic|networkinformation|multimedia|translations)/.+"
    ],
    "linux": ["suyu", "suyu-cmd", "LICENSE\\.txt"],
    "macos": ["suyu\\.app/.+", "LICENSE\\.txt", "__MACOSX/.+"],
    "android-apk": [
      "AndroidManifest\\.xml", "classes[0-9]*\\.dex", "resources\\.arsc", "res/.+",
      "lib/arm64-v8a/[^/]+\\.so", "META-INF/.+", "assets/.+", "kotlin/.+",
      "[^/]+\\.properties", "DebugProbesKt\\.bin"
    ],
    "libretro-linux": ["suyu_libretro\\.so", "LICENSE\\.txt"],
    "libretro-windows": ["suyu_libretro\\.dll", "LICENSE\\.txt"],
    "libretro-macos": ["suyu_libretro\\.dylib", "suyu_libretro_libs/[^/]+\\.dylib", "LICENSE\\.txt"],
    "libretro-android": ["suyu_libretro_android\\.so", "LICENSE\\.txt"],
    "source": ["suyu-[^/]+-source/.+"]
  },
  "approved_exceptions": [
    {
      "kinds": ["source"],
      "path_regex": "suyu-[^/]+-source/externals/breakpad/src/processor/testdata/(ascii_read_av\\.dmp|ascii_read_av_block_write\\.dmp|ascii_read_av_clobber_write\\.dmp|ascii_read_av_conditional\\.dmp|ascii_read_av_then_jmp\\.dmp|ascii_read_av_xchg_write\\.dmp|ascii_write_av\\.dmp|ascii_write_av_arg_to_call\\.dmp|exec_av_on_stack\\.dmp|linux_divide_by_zero\\.dmp|linux_executable_heap\\.dmp|linux_executable_stack\\.dmp|linux_inline\\.dmp|linux_inside_module_exe_region1\\.dmp|linux_inside_module_exe_region2\\.dmp|linux_jmp_to_0\\.dmp|linux_jmp_to_module_not_exe_region\\.dmp|linux_null_dereference\\.dmp|linux_null_read_av\\.dmp|linux_outside_module\\.dmp|linux_overflow\\.dmp|linux_raise_sigabrt\\.dmp|linux_stack_pointer_in_module\\.dmp|linux_stack_pointer_in_stack\\.dmp|linux_stack_pointer_in_stack_alt_name\\.dmp|linux_stacksmash\\.dmp|linux_write_to_nonwritable_module\\.dmp|linux_write_to_nonwritable_region_math\\.dmp|linux_write_to_outside_module\\.dmp|linux_write_to_outside_module_via_math\\.dmp|linux_write_to_under_4k\\.dmp|microdump\\-arm\\.dmp|microdump\\-arm64\\.dmp|microdump\\-mips32\\.dmp|microdump\\-mips64\\.dmp|microdump\\-multiple\\.dmp|microdump\\-withcrashreason\\.dmp|microdump\\-x86\\.dmp|minidump2\\.dmp|minidump_32bit_crash_addr\\.dmp|minidump_crashpad_annotation\\.dmp|null_read_av\\.dmp|null_write_av\\.dmp|read_av_clobber_write\\.dmp|read_av_conditional\\.dmp|read_av_non_null\\.dmp|stack_exhaustion\\.dmp|thread_name_list\\.dmp|tiny\\-exe\\-fastfail\\.dmp|tiny\\-exe\\-with\\-cet\\-xsave\\.dmp|write_av_non_canonical\\.dmp|write_av_non_null\\.dmp)",
      "rules": ["user-data"],
      "reason": "Upstream Google Breakpad processor test fixtures (synthetic and sample minidumps), matched only by the .dmp extension rule; not user crash dumps. Exact file names, no wildcard.",
      "provenance": "submodule externals/breakpad (Google Breakpad), src/processor/testdata"
    },
    {
      "kinds": ["source"],
      "path_regex": "suyu-[^/]+-source/externals/breakpad/src/client/linux/log/(log\\.cc|log\\.h)",
      "rules": ["user-data"],
      "reason": "Breakpad C++ source files (log.cc, log.h) that live in a directory named log; no log content.",
      "provenance": "submodule externals/breakpad (Google Breakpad), src/client/linux/log"
    },
    {
      "kinds": ["source"],
      "path_regex": "suyu-[^/]+-source/externals/libusb/libusb/README\\.md",
      "rules": ["link"],
      "reason": "Upstream documentation symlink README.md -> README in the same directory.",
      "provenance": "submodule externals/libusb"
    },
    {
      "kinds": ["source"],
      "path_regex": "suyu-[^/]+-source/externals/nxapi/docs/lib/README\\.md",
      "rules": ["link"],
      "reason": "Upstream documentation symlink README.md -> index.md in the same directory.",
      "provenance": "submodule externals/nxapi"
    }
  ],
  "exefs": {
    "module_names": ["rtld", "main", "subsdk0", "subsdk1", "subsdk2", "subsdk3", "subsdk4", "subsdk5", "subsdk6", "subsdk7", "subsdk8", "subsdk9", "sdk"],
    "npdm_name": "main.npdm",
    "romfs_names": ["romfs.bin", "romfs"],
    "control_nca_name": "control.nca",
    "control_nacp_name": "control.nacp",
    "icon_name_pattern": "^icon_[A-Za-z]+\\.dat$",
    "ignored_os_metadata": ["desktop.ini", "thumbs.db", ".ds_store"],
    "nso_magic_hex": "4e534f30",
    "npdm_magic_hex": "4d455441",
    "nacp_size": 16384,
    "romfs_header_size": 80
  },
  "shared_coverage": {
    "schema": "suyu-shared-coverage",
    "schema_version": 1,
    "description": "Execution metadata; no raw instruction bytes included."
  }
}
