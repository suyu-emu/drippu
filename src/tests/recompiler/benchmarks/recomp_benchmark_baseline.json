{
  "description": "Portable guardrails for the deterministic recompiler benchmark suite. Timing values are intentionally not fixed across hosts.",
  "kind": "recomp_benchmark_baseline",
  "schema_version": 2,
  "thresholds": {
    "max_aot_to_jit_transition_ratio": 1.0,
    "max_invalid_json_size_bytes": 10485760,
    "min_iterations": 4,
    "required_backends": [ "hybrid_aot", "jit" ],
    "required_workloads": 3
  },
  "workloads": [ "alu_add_reload_svc", "tls_svc", "plain_svc" ]
}