<component type="desktop-application">
  <id>dev.suyu_emu.suyu</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>drippu</name>
  <summary>Nintendo Switch emulator</summary>
  <description>
    <p>drippu is an open-source Nintendo Switch emulator and native recompiler — a continued fork of the suyu codebase, itself based on Eden / yuzu.</p>
    <p>The emulator is capable of running commercial games at full speed when hardware requirements are met, using user-provided games and encryption keys.</p>
    <p>Check the project repository for builds, compatibility notes, and contributing information.</p>
  </description>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <keywords>
    <keyword>switch</keyword>
    <keyword>emulator</keyword>
  </keywords>
  <url type="homepage">https://github.com/SourCreamCulture/drippu</url>
  <url type="bugtracker">https://github.com/SourCreamCulture/drippu/issues</url>
  <url type="vcs-browser">https://github.com/SourCreamCulture/drippu</url>
  <launchable type="desktop-id">dev.suyu_emu.suyu.desktop</launchable>
  <provides>
    <binary>suyu</binary>
    <binary>suyu-cmd</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
  </supports>
  <requires>
    <memory>8192</memory>
  </requires>
  <recommends>
    <memory>16384</memory>
  </recommends>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>SourCreamCulture / drippu</developer_name>
  <content_rating type="oars-1.0"/>
</component>
